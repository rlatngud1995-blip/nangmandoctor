{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    { "source": "/seoul", "destination": "/area/seoul/", "permanent": true },
    { "source": "/gyeonggi", "destination": "/area/gyeonggi/", "permanent": true },
    { "source": "/incheon", "destination": "/area/incheon/", "permanent": true },
    { "source": "/chungbuk", "destination": "/area/chungbuk/", "permanent": true },
    { "source": "/chungnam", "destination": "/area/chungnam/", "permanent": true },
    { "source": "/gyeongnam", "destination": "/area/gyeongnam/", "permanent": true },
    { "source": "/gyeongbuk", "destination": "/area/gyeongbuk/", "permanent": true },
    { "source": "/busan", "destination": "/area/busan/", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
