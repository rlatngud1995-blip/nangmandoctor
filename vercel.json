{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": null,
  "trailingSlash": true,
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
